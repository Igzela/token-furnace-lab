{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EscalationReport",
  "description": "Structured report for human decision when gate outputs ESCALATE",
  "type": "object",
  "required": ["reason", "unresolved_findings", "evidence_paths", "attempted_repairs", "decision_needed_from_human", "safe_default"],
  "properties": {
    "reason": {
      "type": "string",
      "description": "Why this artifact was escalated"
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "blocking", "claim"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "blocking": { "type": "boolean" },
          "claim": { "type": "string" },
          "correction": { "type": "string" }
        }
      },
      "description": "Findings that prevented acceptance"
    },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to evidence files supporting the findings"
    },
    "attempted_repairs": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of repair rounds attempted"
    },
    "decision_needed_from_human": {
      "type": "string",
      "description": "What the human reviewer needs to decide"
    },
    "safe_default": {
      "type": "string",
      "description": "Default action if human does not respond"
    }
  }
}
